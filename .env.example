# ── Supabase (shared across all 4 apps) ─────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
# used by db:gen-types / server-side migrations tooling only — never expose client-side

# ── App identity ─────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── ZATCA e-invoicing (Saudi VAT compliance, POS app) ────────────────
ZATCA_ENVIRONMENT=sandbox
ZATCA_API_BASE_URL=
ZATCA_CERTIFICATE=
ZATCA_PRIVATE_KEY=
ZATCA_OTP=

# ── Maps / delivery tracking (Customer app) ──────────────────────────
NEXT_PUBLIC_MAPS_API_KEY=

# ── Twilio (phone OTP + WhatsApp re-engagement) ──────────────────────
# Configured in Supabase Studio → Authentication → Providers → Phone for
# OTP delivery, not read directly by app code — these exist so the
# Developer Portal's credentials panel can report configuration status.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# ── Payment gateway (Customer/POS checkout) ──────────────────────────
# apps/customer and apps/pos ship a mock adapter (see lib/payments/adapter.ts
# in each) until these are set and a real adapter is wired in.
PAYMENT_GATEWAY_API_KEY=
PAYMENT_GATEWAY_SECRET=

# ── Feature flags default source (overridden at runtime via Developer Portal) ─
NEXT_PUBLIC_FEATURE_FLAGS_SOURCE=supabase
